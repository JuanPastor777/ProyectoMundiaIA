# Copia este archivo como ".env" en la misma carpeta (backend/) y coloca tus
# credenciales reales. El archivo ".env" NUNCA debe subirse a GitHub.

# --- Supabase ---
# Panel de Supabase > Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_clave_service_role_o_anon_de_supabase

# --- OpenAI ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
# Dominios del frontend permitidos, separados por coma
CORS_ORIGINS=http://localhost:5173
